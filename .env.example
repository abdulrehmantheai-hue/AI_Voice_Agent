# SQLite works for local demo. For deployment use persistent PostgreSQL.
DATABASE_URL=sqlite:///./patients.db
# IMPORTANT: choose strong random distinct secrets; never commit real values
API_KEY=REPLACE_WITH_LONG_RANDOM_API_KEY
DASHBOARD_PASSWORD=REPLACE_WITH_LONG_RANDOM_DASHBOARD_PASSWORD
WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_WEBHOOK_SECRET
# Set true only behind HTTPS reverse proxy in production
COOKIE_SECURE=false
